{
  "name": "ateeducacion/canarias-route-matrix",
  "description": "Lector de distancias CEDIST04 para PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "AteEducacion\\CanariasRouteMatrix\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AteEducacion\\CanariasRouteMatrix\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.10 || ^4.0"
  },
  "scripts": {
    "test": "phpunit",
    "lint": [
      "phpcs --standard=PSR12 src tests",
      "phpstan analyse --level=8 src"
    ]
  }
}
